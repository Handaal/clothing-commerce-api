# Phase 1D staff/admin authentication requires the server-only values below.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# Comma-separated exact browser origins, for example http://localhost:3000.
# CLERK_AUTHORIZED_PARTIES=
# Comma-separated exact browser/Electron origins allowed to call the API.
# COMMERCE_CORS_ALLOWED_ORIGINS=http://localhost:3001
# Optional PEM public key for networkless Clerk session-token verification.
# CLERK_JWT_KEY=
# Future integrations remain unset until their approved phase.
# STRIPE_SECRET_KEY=
# PAYMOB_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
# RESEND_API_KEY=
# SENTRY_DSN=
# Never expose these through NEXT_PUBLIC_, VITE_, or EXPO_PUBLIC_ names.
