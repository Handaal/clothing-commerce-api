{
  "openapi": "3.1.0",
  "info": { "title": "Clothing Commerce API", "version": "0.1.0" },
  "tags": [
    { "name": "me", "description": "Identity bootstrap and permission context." },
    { "name": "catalog", "description": "Read-only product catalog." },
    { "name": "inventory", "description": "Read-only inventory balances." },
    { "name": "orders", "description": "Read-only orders and fulfillment progress." }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/me/tenants": {
      "get": {
        "operationId": "getMyTenants",
        "tags": ["me"],
        "summary": "List the caller's own selectable active tenants.",
        "description": "Identity-scoped bootstrap. Requires only a valid session (no X-Tenant-Id) and returns solely the verified caller's own active memberships against active tenants.",
        "security": [{ "clerkSessionToken": [] }],
        "responses": {
          "200": {
            "description": "The caller's active memberships and selectable tenants.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MeTenants" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/api/v1/me/context": {
      "get": {
        "operationId": "getMyContext",
        "tags": ["me"],
        "summary": "Read the caller's effective read capability for a tenant.",
        "security": [{ "clerkSessionToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "responses": {
          "200": {
            "description": "The caller's permission-specific read context.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MeContextResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "operationId": "listProducts",
        "tags": ["catalog"],
        "summary": "List products in the caller's catalog read scope.",
        "security": [{ "clerkSessionToken": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          {
            "name": "brandId",
            "in": "query",
            "required": false,
            "description": "Restrict to a single in-tenant brand.",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Restrict to a product status.",
            "schema": { "type": "string", "enum": ["draft", "active", "archived"] }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum items per page (1-100, default 25).",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque forward-pagination cursor from a previous page's nextCursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of product summaries.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "404": { "$ref": "#/components/responses/Error404" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/api/v1/products/{productId}": {
      "get": {
        "operationId": "getProduct",
        "tags": ["catalog"],
        "summary": "Read a single product's detail.",
        "security": [{ "clerkSessionToken": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The product detail.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductDetailResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "404": { "$ref": "#/components/responses/Error404" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/api/v1/inventory": {
      "get": {
        "operationId": "listInventory",
        "tags": ["inventory"],
        "summary": "List inventory balances in the caller's inventory read scope.",
        "security": [{ "clerkSessionToken": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          {
            "name": "inventoryLocationId",
            "in": "query",
            "required": false,
            "description": "Restrict to a single in-tenant inventory location.",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "variantId",
            "in": "query",
            "required": false,
            "description": "Restrict to a single variant.",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum items per page (1-100, default 25).",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque forward-pagination cursor from a previous page's nextCursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of inventory balances.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InventoryListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "404": { "$ref": "#/components/responses/Error404" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "tags": ["orders"],
        "summary": "List orders in the caller's orders read scope.",
        "security": [{ "clerkSessionToken": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          {
            "name": "channel",
            "in": "query",
            "required": false,
            "description": "Restrict to a channel.",
            "schema": { "type": "string", "enum": ["pos", "online"] }
          },
          {
            "name": "brandId",
            "in": "query",
            "required": false,
            "description": "Restrict to a single in-tenant brand.",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "branchId",
            "in": "query",
            "required": false,
            "description": "Restrict to a single in-tenant branch.",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Restrict to an order status.",
            "schema": { "type": "string", "enum": ["placed", "cancelled"] }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum items per page (1-100, default 25).",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque forward-pagination cursor from a previous page's nextCursor.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of order summaries.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/OrderListResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "404": { "$ref": "#/components/responses/Error404" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/api/v1/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "tags": ["orders"],
        "summary": "Read a single order's detail and fulfillment progress.",
        "security": [{ "clerkSessionToken": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The order detail with embedded fulfillment progress.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderDetailResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "404": { "$ref": "#/components/responses/Error404" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clerkSessionToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Clerk session token presented as a Bearer credential."
      }
    },
    "parameters": {
      "TenantIdHeader": {
        "name": "X-Tenant-Id",
        "in": "header",
        "required": true,
        "description": "The tenant the request operates within.",
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "Error400": {
        "description": "Invalid request.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Error401": {
        "description": "Authentication is required.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Error403": {
        "description": "The operation is not permitted.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Error404": {
        "description": "The resource was not found.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Error409": {
        "description": "The request conflicts with current state.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Error422": {
        "description": "The request was semantically rejected.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Error500": {
        "description": "An unexpected error occurred.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      }
    },
    "schemas": {
      "HealthResponse": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" }
        },
        "required": ["status", "version"],
        "additionalProperties": false
      },
      "ApiError": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string" },
              "requestId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "array",
                      "items": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
                    },
                    "message": { "type": "string" }
                  },
                  "required": ["path", "message"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["code", "message", "requestId"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "PageInfo": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "nextCursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "hasMore": { "type": "boolean" }
        },
        "required": ["nextCursor", "hasMore"],
        "additionalProperties": false
      },
      "MeTenants": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "tenantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "tenantName": { "type": "string" },
            "membershipId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": ["tenantId", "tenantName", "membershipId"],
          "additionalProperties": false
        }
      },
      "MeContextResponse": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "tenant": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["provisioning", "active", "suspended", "archived"]
              }
            },
            "required": ["id", "name", "status"],
            "additionalProperties": false
          },
          "membership": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": ["id"],
            "additionalProperties": false
          },
          "access": {
            "type": "object",
            "properties": {
              "catalog": {
                "type": "object",
                "properties": {
                  "canRead": { "type": "boolean" },
                  "tenantWide": { "type": "boolean" },
                  "brands": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": { "type": "string" }
                      },
                      "required": ["id", "name"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["canRead", "tenantWide", "brands"],
                "additionalProperties": false
              },
              "inventory": {
                "type": "object",
                "properties": {
                  "canRead": { "type": "boolean" },
                  "tenantWide": { "type": "boolean" },
                  "locations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": { "type": "string" },
                        "branchId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            { "type": "null" }
                          ]
                        }
                      },
                      "required": ["id", "name", "branchId"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["canRead", "tenantWide", "locations"],
                "additionalProperties": false
              },
              "orders": {
                "type": "object",
                "properties": {
                  "canRead": { "type": "boolean" },
                  "tenantWide": { "type": "boolean" },
                  "brands": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": { "type": "string" }
                      },
                      "required": ["id", "name"],
                      "additionalProperties": false
                    }
                  },
                  "branches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": { "type": "string" }
                      },
                      "required": ["id", "name"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["canRead", "tenantWide", "brands", "branches"],
                "additionalProperties": false
              }
            },
            "required": ["catalog", "inventory", "orders"],
            "additionalProperties": false
          }
        },
        "required": ["tenant", "membership", "access"],
        "additionalProperties": false
      },
      "ProductSummary": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "styleCode": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "status": { "type": "string", "enum": ["draft", "active", "archived"] },
          "brandId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["id", "name", "styleCode", "status", "brandId"],
        "additionalProperties": false
      },
      "ProductListResponse": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "name": { "type": "string" },
                "styleCode": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                "status": { "type": "string", "enum": ["draft", "active", "archived"] },
                "brandId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "required": ["id", "name", "styleCode", "status", "brandId"],
              "additionalProperties": false
            }
          },
          "pageInfo": {
            "type": "object",
            "properties": {
              "nextCursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
              "hasMore": { "type": "boolean" }
            },
            "required": ["nextCursor", "hasMore"],
            "additionalProperties": false
          }
        },
        "required": ["items", "pageInfo"],
        "additionalProperties": false
      },
      "ProductDetailResponse": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "product": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
