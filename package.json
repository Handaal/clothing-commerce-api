{
  "name": "clothing-commerce-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm openapi:generate && pnpm sdk:build && next build",
    "dev": "next dev",
    "dev:provision-identity": "node scripts/provision-dev-identity.mjs",
    "dev:provision-commerce-fixture": "node scripts/provision-dev-commerce-fixture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "sdk:build": "pnpm --filter @shifted/clothing-commerce-sdk build",
    "sdk:pack": "pnpm sdk:build && pnpm --filter @shifted/clothing-commerce-sdk pack --pack-destination ./artifacts",
    "start": "next start",
    "supabase:reset": "supabase db reset --local --no-seed",
    "supabase:start": "supabase start --exclude gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop --no-backup",
    "test": "vitest run --exclude tests/authorization/** --exclude tests/authorization-integration/** --exclude tests/inventory-integration/** --exclude tests/inventory-write-integration/** --exclude tests/orders-integration/** --exclude tests/fulfillments-integration/** --exclude tests/api-integration/** --exclude tests/pos-sale-integration/** --exclude tests/offline-pos-integration/** --exclude tests/catalog-management-integration/** --exclude tests/dev-provisioning-integration/** --exclude tests/dev-commerce-fixture-integration/** --exclude tests/online-commerce-integration/** --exclude tests/returns-integration/** --exclude tests/suppliers-integration/**",
    "test:api:contracts": "vitest run --dir tests/contracts",
    "test:api:integration": "node scripts/test-api-integration.mjs",
    "test:inventory:write:integration": "node scripts/test-inventory-write-integration.mjs",
    "test:openapi": "vitest run tests/openapi-drift.test.ts tests/openapi/openapi-structure.test.ts",
    "test:sdk": "node scripts/test-sdk.mjs",
    "test:all": "pnpm test && pnpm test:authorization && pnpm test:authorization:integration && pnpm test:persistence && pnpm test:catalog:persistence && pnpm test:inventory:persistence && pnpm test:inventory:operations:persistence && pnpm test:orders:persistence && pnpm test:fulfillment:persistence && pnpm test:rls && pnpm test:catalog:rls && pnpm test:inventory:rls && pnpm test:inventory:operations:rls && pnpm test:orders:rls && pnpm test:fulfillment:rls && pnpm test:pos:offline:rls && pnpm test:catalog:concurrency && pnpm test:inventory:concurrency && pnpm test:inventory:operations:concurrency && pnpm test:orders:concurrency && pnpm test:fulfillment:concurrency && pnpm test:inventory:operations:integration && pnpm test:inventory:write:integration && pnpm test:orders:integration && pnpm test:fulfillment:integration && pnpm test:pos:sale:integration && pnpm test:pos:offline:integration && pnpm test:catalog:management && pnpm test:catalog:management:integration && pnpm test:online:persistence && pnpm test:online:integration && pnpm test:promotions:persistence && pnpm test:promotions:concurrency && pnpm test:reporting:persistence && pnpm test:reporting:export:persistence && pnpm test:settings:persistence",
    "validate:release": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:all && pnpm test:openapi && pnpm test:sdk && pnpm build",
    "test:authorization": "vitest run --dir tests/authorization",
    "test:authorization:integration": "node scripts/test-authorization-integration.mjs",
    "test:dev:provisioning": "node scripts/test-dev-provisioning.mjs",
    "test:dev:commerce-fixture": "node scripts/test-dev-commerce-fixture.mjs",
    "test:catalog:concurrency": "node scripts/test-catalog-concurrency.mjs",
    "test:fulfillment:concurrency": "node scripts/test-fulfillment-concurrency.mjs",
    "test:fulfillment:integration": "node scripts/test-fulfillment-integration.mjs",
    "test:fulfillment:persistence": "node scripts/test-fulfillment-persistence.mjs",
    "test:fulfillment:rls": "node scripts/test-fulfillment-rls.mjs",
    "test:catalog:persistence": "node scripts/test-catalog-persistence.mjs",
    "test:catalog:management": "node scripts/test-catalog-management.mjs",
    "test:catalog:management:integration": "node scripts/test-catalog-management-integration.mjs",
    "test:catalog:rls": "node scripts/test-catalog-rls.mjs",
    "test:inventory:concurrency": "node scripts/test-inventory-concurrency.mjs",
    "test:inventory:operations:concurrency": "node scripts/test-inventory-operations-concurrency.mjs",
    "test:inventory:operations:integration": "node scripts/test-inventory-operations-integration.mjs",
    "test:inventory:operations:persistence": "node scripts/test-inventory-operations-persistence.mjs",
    "test:inventory:operations:rls": "node scripts/test-inventory-operations-rls.mjs",
    "test:inventory:persistence": "node scripts/test-inventory-persistence.mjs",
    "test:management:persistence": "node scripts/test-management-persistence.mjs",
    "test:inventory:rls": "node scripts/test-inventory-rls.mjs",
    "test:orders:concurrency": "node scripts/test-orders-concurrency.mjs",
    "test:orders:integration": "node scripts/test-orders-integration.mjs",
    "test:orders:persistence": "node scripts/test-orders-persistence.mjs",
    "test:promotions:persistence": "node scripts/test-promotions-persistence.mjs",
    "test:promotions:concurrency": "node scripts/test-promotions-concurrency.mjs",
    "test:reporting:persistence": "node scripts/test-reporting-persistence.mjs",
    "test:settings:persistence": "node scripts/test-settings-persistence.mjs",
    "test:reporting:export:persistence": "node scripts/test-reporting-export-persistence.mjs",
    "test:orders:rls": "node scripts/test-orders-rls.mjs",
    "test:pos:sale:integration": "node scripts/test-pos-sale-integration.mjs",
    "test:pos:offline:integration": "node scripts/test-offline-pos-integration.mjs",
    "test:pos:offline:rls": "node scripts/test-offline-pos-rls.mjs",
    "test:persistence": "node scripts/test-persistence.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter @shifted/clothing-commerce-sdk typecheck",
    "test:online:integration": "node scripts/test-online-commerce.mjs",
    "test:online:persistence": "node scripts/test-online-persistence.mjs",
    "test:online:rls": "node scripts/test-online-rls.mjs",
    "test:returns:integration": "node scripts/test-returns.mjs",
    "test:returns:persistence": "node scripts/test-returns-persistence.mjs",
    "test:returns:rls": "node scripts/test-returns.mjs --rls-only",
    "test:returns:safety": "node scripts/test-returns-safety.mjs",
    "test:suppliers:integration": "node scripts/test-returns.mjs --suppliers",
    "test:suppliers:persistence": "node scripts/test-returns-persistence.mjs --suppliers",
    "test:suppliers:rls": "node scripts/test-returns.mjs --suppliers --rls-only",
    "test:staff:persistence": "node scripts/test-returns-persistence.mjs --staff",
    "test:staff:rls": "node scripts/test-returns.mjs --staff --rls-only"
  },
  "dependencies": {
    "@clerk/backend": "3.16.8",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
